AMVGGDatabase._Counts = { Pets = 791, Eggs = 41, Petwear = 237, Strollers = 76, Food = 51, Vehicles = 199, Toys = 145, Gifts = 42, Stickers = 108, Houses = 37 }

local FLAG_INDEX = { Plain = 1, F = 2, R = 3, FR = 4 }

local function flagIndex(flags)
    if flags == nil then return 4 end
    flags = string.upper(tostring(flags))
    local f = string.find(flags, "F", 1, true) ~= nil
    local r = string.find(flags, "R", 1, true) ~= nil
    if f and r then return FLAG_INDEX.FR elseif f then return FLAG_INDEX.F elseif r then return FLAG_INDEX.R end
    return FLAG_INDEX.Plain
end

function AMVGGDatabase.GetValue(category, name, system, form, flags)
    local cat = AMVGGDatabase.Items[category]
    if not cat then return 0 end
    local item = cat[name]
    if not item then return 0 end
    local mult = AMVGGDatabase.SystemMultipliers[system or "Frost"]
    if not mult then return 0 end
    local arr = item[form or "Regular"]
    if not arr then return 0 end
    local base = arr[flagIndex(flags)] or arr[1] or 0
    return math.floor(base * mult * 100 + 0.5) / 100
end

function AMVGGDatabase.GetPetValue(petName, system, petForm, flags)
    return AMVGGDatabase.GetValue("Pets", petName, system, petForm, flags)
end

function AMVGGDatabase.CalculateTotal(inventoryTable)
    local sum = 0
    for _, item in ipairs(inventoryTable) do
        sum = sum + AMVGGDatabase.GetValue(item.Category or "Pets", item.Name, item.System, item.Form, item.Flags)
    end
    return sum
end

